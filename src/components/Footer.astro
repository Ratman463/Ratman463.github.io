---
/**
 * Footer —— 品牌 + 简介 + 版权
 */
const REPO_URL = 'https://github.com/Ratman463/Atlas';
const year = new Date().getFullYear();
---

<footer class="border-t border-[#e8e8ed] bg-[#f5f5f7]">
  <div class="container py-8">
    <div class="flex flex-col items-center gap-3 text-center">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[19px] font-semibold text-[#1d1d1f] transition-opacity hover:opacity-70"
      >
        <span data-i18n="footer.brand">知图</span> <span class="text-[#6e6e73]">·</span> Atlas
      </a>

      <p class="max-w-md text-[13px] leading-relaxed text-[#6e6e73]">
        <span data-i18n="footer.tag.1">本地知识库 · AI 问答 · 文档生成</span><br class="sm:hidden" />
        <span data-i18n="footer.tag.2">你的资料留在本地，模型由你配置。</span>
      </p>
    </div>
  </div>

  <div class="border-t border-[#e8e8ed]">
    <div class="container py-4">
      <p class="text-center text-[12px] text-[#86868b]">
        © 2024-{year} Ratman463. Released under Apache License 2.0.
      </p>
    </div>
  </div>
</footer>