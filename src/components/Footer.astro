---
/**
 * Footer —— 版权、协议、GitHub 链接
 */
const REPO_URL = 'https://github.com/Ratman463/Atlas';
const year = new Date().getFullYear();
---

<footer class="border-t border-[#e8e8ed] bg-[#f5f5f7]">
  <div class="container py-14">
    <div class="flex flex-col items-center gap-6 text-center">
      <a
        href="#hero"
        class="text-[19px] font-semibold text-[#1d1d1f] transition-opacity hover:opacity-70"
      >
        知图 <span class="text-[#6e6e73]">·</span> Atlas
      </a>

      <p class="max-w-md text-[14px] leading-relaxed text-[#6e6e73]">
        本地知识库 · AI 问答 · 文档生成<br class="sm:hidden" />
        你的资料留在本地，模型由你配置。
      </p>

      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[13px]">
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#6e6e73] transition-colors hover:text-[#1d1d1f]"
        >
          GitHub
        </a>
        <a
          href="https://github.com/Ratman463/Atlas/blob/main/LICENSE"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#6e6e73] transition-colors hover:text-[#1d1d1f]"
        >
          MIT
        </a>
        <a
          href="#hero"
          class="text-[#6e6e73] transition-colors hover:text-[#1d1d1f]"
        >
          回到顶部 ↑
        </a>
      </nav>

      <div class="h-px w-24 bg-[#d2d2d7]"></div>

      <p class="text-[12px] text-[#86868b]">
        © 2024-{year} Ratman463. Released under MIT.
      </p>
    </div>
  </div>
</footer>