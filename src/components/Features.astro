---
/**
 * 知图核心特性
 * - 三大核心功能：大卡片横向排列
 * - 六项细节特性：3 列网格
 */
import FeatureCard, { type FeatureCardProps } from './FeatureCard.tsx';
import {
  UploadCloud,
  Search,
  FileText,
  ShieldCheck,
  KeyRound,
  Zap,
  Languages,
  Boxes,
} from 'lucide-react';

/* 三大核心功能 */
const coreFeatures = [
  {
    title: '知识库',
    desc: 'PDF / Word / TXT / Markdown 拖入即自动入库，语义切块 + 向量化，边存边可查。',
    icon: '库',
  },
  {
    title: '智能问答',
    desc: '基于 RAG 检索你的文档，交给任意大模型综合回答，流式输出并标注引用来源。',
    icon: '问',
  },
  {
    title: '文档生成',
    desc: '一句话描述需求，模型翻阅知识库后生成 Markdown，一键渲染成排版好的 .docx。',
    icon: '文',
  },
];

/* 细节特性 */
const features: FeatureCardProps[] = [
  {
    icon: ShieldCheck,
    title: '资料本地化',
    description: '文档、向量库、检索全部跑在本地，不上传任何服务器。你的资料，你做主。',
  },
  {
    icon: KeyRound,
    title: '自备 API Key',
    description: '连接你自己的 Endpoint、Key、Model，OpenAI / DeepSeek / Moonshot 等任意兼容接口。',
  },
  {
    icon: Zap,
    title: '流式输出',
    description: '问答逐字流式返回，边生成边显示，不干等一整个大段落。',
  },
  {
    icon: Search,
    title: '引用来源',
    description: '每条回答都标注来自哪份文档、相似度多少，关键内容可溯源核对。',
  },
  {
    icon: Languages,
    title: '提示词可定制',
    description: '内置默认角色，也可自定义 system prompt，问答与生成共用一套规则。',
  },
  {
    icon: Boxes,
    title: '本地运行',
    description: 'Python 一条命令启动，单机即可跑，浏览器里打开就能用。',
  },
];
---

<section id="features" class="section bg-[#f5f5f7]">
  <div class="container">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">核心功能</p>
      <h2 class="text-[32px] font-semibold text-[#1d1d1f] sm:text-[40px]">
        三个动作，盘活你的文档。
      </h2>
      <p class="mt-4 text-[17px] leading-[1.6] text-[#6e6e73]">
        上传入库 · 向库提问 · 一键成文。模型的配置始终握在你手里。
      </p>
    </div>

    <!-- 三大核心功能 -->
    <div class="reveal mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {coreFeatures.map((item) => (
        <div class="card flex h-full flex-col p-8">
          <div
            class="mb-5 flex h-14 w-14 items-center justify-center rounded-[16px] bg-[#0071e3] text-[22px] font-semibold text-white"
            aria-hidden="true"
          >
            {item.icon}
          </div>
          <h3 class="text-[21px] font-semibold text-[#1d1d1f]">{item.title}</h3>
          <p class="mt-3 text-[14.5px] leading-[1.75] text-[#424245]">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- 细节特性 -->
    <div class="reveal mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <FeatureCard
          icon={feature.icon}
          title={feature.title}
          description={feature.description}
        />
      ))}
    </div>
  </div>
</section>