---
/**
 * Hero 区域
 * - 苹果风：超大标题、副标题、双按钮
 * - 下方一个产品界面示意卡片（纯 CSS 画，不依赖图片）
 */
const REPO_URL = 'https://github.com/Ratman463/EasyRag';
---

<section
  id="hero"
  class="relative flex min-h-[88vh] flex-col items-center justify-center px-6 pt-24 pb-16 text-center"
>
  <div class="relative z-10 flex max-w-3xl flex-col items-center">
    <!-- 大标题 -->
    <h1
      class="animate-in text-[56px] font-semibold leading-[1.07] tracking-[-0.015em] text-[#1d1d1f] sm:text-[72px] md:text-[80px]"
    >
      知图
    </h1>

    <!-- 副标题 -->
    <p
      class="animate-in animate-in-delay-1 mt-4 text-[24px] font-semibold leading-snug text-[#1d1d1f] sm:text-[32px] md:text-[36px]"
    >
      本地知识库 · AI 问答 · 文档生成
    </p>

    <p
      class="animate-in animate-in-delay-2 mt-5 max-w-xl text-[17px] leading-[1.6] text-[#6e6e73] sm:text-[19px] sm:leading-[1.47]"
    >
      上传文档，问库即答，一句话成文。<br class="hidden sm:block" />
      你的资料留在本地，大模型只负责思考。
    </p>

    <!-- 按钮 -->
    <div
      class="animate-in animate-in-delay-3 mt-10 flex flex-col gap-4 sm:flex-row sm:gap-3"
    >
      <a href="#features" class="btn btn-primary">了解功能</a>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
      >
        GitHub
      </a>
    </div>
  </div>

  <!-- 产品界面示意：三大功能卡 -->
  <div
    class="animate-in animate-in-delay-4 mt-20 w-full max-w-4xl rounded-[28px] border border-[#e8e8ed] bg-[#f5f5f7] p-4 shadow-[0_20px_60px_rgba(0,0,0,0.08)] sm:p-6"
  >
    <!-- 窗口栏 -->
    <div class="mb-4 flex items-center gap-2 px-2">
      <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
      <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
      <span class="ml-3 text-[13px] font-medium text-[#86868b]">知图</span>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <!-- 知识库 -->
      <div class="rounded-[18px] bg-white p-5 text-left shadow-sm">
        <div
          class="mb-3 flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#0071e3]/10 text-[#0071e3]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" fill="currentColor"/>
          </svg>
        </div>
        <p class="text-[15px] font-semibold text-[#1d1d1f]">知识库</p>
        <p class="mt-1 text-[13px] leading-[1.5] text-[#6e6e73]">
          PDF / Word / TXT / MD 拖入即入库，自动向量化
        </p>
      </div>

      <!-- 智能问答 -->
      <div class="rounded-[18px] bg-white p-5 text-left shadow-sm">
        <div
          class="mb-3 flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#0071e3]/10 text-[#0071e3]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z" stroke="currentColor" stroke-width="1.6"/>
            <path d="M9.5 9.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="text-[15px] font-semibold text-[#1d1d1f]">智能问答</p>
        <p class="mt-1 text-[13px] leading-[1.5] text-[#6e6e73]">
          RAG 检索 + 大模型流式回答，附来源标注
        </p>
      </div>

      <!-- 文档生成 -->
      <div class="rounded-[18px] bg-white p-5 text-left shadow-sm">
        <div
          class="mb-3 flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#0071e3]/10 text-[#0071e3]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M6 3h8l4 4v14H6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M14 3v4h4M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="text-[15px] font-semibold text-[#1d1d1f]">文档生成</p>
        <p class="mt-1 text-[13px] leading-[1.5] text-[#6e6e73]">
          一句话描述需求，一键下载排版好的 Word
        </p>
      </div>
    </div>
  </div>
</section>