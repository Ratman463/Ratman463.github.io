---
/**
 * 知图 (Atlas) 官网布局
 * 苹果风：白底、系统字体、淡入动画
 */
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = '知图 · 知识库 + AI 问答 + 文档生成',
  description = '知图（Atlas）：一个轻量的本地知识库工具，支持在线大模型问答与 Word 文档生成。上传文档，问库即答，一句话成文。你的资料留在本地，模型用你自己的 API Key 接入。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />

    <!-- PingFang / SF 系统字体栈即可，无需外部字体 -->

    {/* 首屏防闪烁：默认 zh 不需要等 JS；非 zh 时提前隐藏 body，等 LanguageSwitcher 应用完语言再淡入 */}
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('atlas.lang');
          if (v === 'en') {
            var el = document.documentElement;
            el.setAttribute('lang', 'en');
            el.setAttribute('data-lang-pending', '1');
          }
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      body { transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
      html[data-lang-pending] body { opacity: 0; }
    </style>
  </head>
  <body>
    <LanguageSwitcher />
    <slot />

    <!-- 进入视口淡入动画 -->
    <script>
      const initReveal = () => {
        const els = document.querySelectorAll<HTMLElement>('.reveal');
        if (els.length === 0) return;

        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        els.forEach((el) => observer.observe(el));
      };

      document.addEventListener('DOMContentLoaded', initReveal);
    </script>
  </body>
</html>